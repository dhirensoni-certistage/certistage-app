# ===========================================
# CertiStage Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE
# ===========================================
# MongoDB connection string (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/certistage?retryWrites=true&w=majority

# ===========================================
# AUTHENTICATION
# ===========================================
# Admin setup secret - used only once to create first admin account
# Change this to a secure random string
ADMIN_SETUP_SECRET=your-secure-setup-secret-here

# JWT Secret for session tokens (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ===========================================
# PAYMENT GATEWAY - RAZORPAY
# ===========================================
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret - Set this in Razorpay Dashboard > Settings > Webhooks
# Webhook URL: https://certistage.com/api/razorpay/webhook
# Events to enable: payment.captured, payment.failed, order.paid, refund.created
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# APPLICATION
# ===========================================
# Your application URL (used for password reset links, etc.)
# Development: http://localhost:3000
# Production: https://certistage.com
NEXT_PUBLIC_APP_URL=https://certistage.com

# Node environment (development/production)
NODE_ENV=production

# ===========================================
# GOOGLE OAUTH CONFIGURATION
# ===========================================
# Get these from https://console.developers.google.com/
# Add both URLs in Google Cloud Console:
# Origins: http://localhost:3000, https://certistage.com
# Redirects: http://localhost:3000/api/auth/callback/google, https://certistage.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXTAUTH_SECRET=your_nextauth_secret_key_here
# Development: http://localhost:3000
# Production: https://certistage.com
NEXTAUTH_URL=https://certistage.com

# ===========================================
# EMAIL CONFIGURATION
# ===========================================
# Provider order: Brevo, then SendGrid, then SMTP. Set one.

# Brevo (recommended): https://app.brevo.com -> SMTP & API -> API Keys.
# The sender must be a verified sender or on an authenticated domain in Brevo.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=noreply@certistage.com
BREVO_FROM_NAME=CertiStage

# Certificate emails to recipients (Recipients > Email certificates). ZeptoMail when set;
# otherwise Brevo with a 100/day cap so OTP emails keep their share of the free quota.
ZEPTOMAIL_TOKEN=Zoho-enczapikey xxxxxxxxxxxxxxxx
ZEPTOMAIL_FROM_EMAIL=noreply@certistage.com
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# CERT_EMAIL_DAILY_CAP=2000

# SendGrid (used only when BREVO_API_KEY is not set)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@certistage.com

# SMTP fallback (used only when neither key above is set)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@certistage.com
SMTP_PASS=your_email_password

# From email address for SMTP (will use SMTP_USER if not set)
FROM_EMAIL=CertiStage <noreply@certistage.com>
ADMIN_EMAIL=admin@certistage.com
ADMIN_CC_EMAIL=your-cc-email@example.com

# ===========================================
# RATE LIMITING (Optional - Upstash Redis)
# ===========================================
# Get these from https://console.upstash.com/
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# OPTIONAL FEATURES
# ===========================================
# Enable/disable features
# ENABLE_EMAIL_VERIFICATION=true
# ENABLE_TWO_FACTOR_AUTH=false
# ENABLE_TEST_PLAN=true
# NEXT_PUBLIC_ENABLE_TEST_PLAN=true

# ===========================================
# BACKUPS
# ===========================================
# Vercel calls /api/cron/backup every Saturday 20:30 UTC (Sunday 02:00 IST)
# with "Authorization: Bearer <CRON_SECRET>". Generate a long random string.
CRON_SECRET=change-me-to-a-long-random-string
# Where the weekly backup email goes (falls back to ADMIN_EMAIL)
BACKUP_EMAIL=you@example.com

# Google Search Console HTML-tag verification code (content attribute only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
